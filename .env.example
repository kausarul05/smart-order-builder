# Google AI Studio key for the sales assistant (Part F).
# Create a FREE key at https://aistudio.google.com/apikey and put the real
# value in .env.local (git-ignored). Never commit a real key.
VITE_GEMINI_API_KEY=

# Flash model used for function calling. Override only if the free-tier
# model name changes.
VITE_GEMINI_MODEL=gemini-2.0-flash
