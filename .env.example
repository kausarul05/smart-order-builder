# Google AI Studio key for the sales assistant (Part F).
# Create a FREE key at https://aistudio.google.com/apikey and put the real
# value in .env.local (git-ignored). Never commit a real key.
VITE_GEMINI_API_KEY=

# The Flash model used for function calling. Google retires model ids -
# gemini-2.0-flash was shut down on 1 June 2026 - so if the assistant
# reports an unknown model, put a current one from Google AI Studio here.
# Flash-Lite is the default because its free daily allowance is the
# largest, and each question costs two calls.
VITE_GEMINI_MODEL=gemini-3.5-flash-lite
